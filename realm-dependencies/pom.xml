                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter-actuator</artifactId>
                <version>${flowable.version}</version>
            </dependency>

            <!-- ====================== 工具类库 ====================== -->
            <!-- Realm 框架通用工具依赖 -->
            <dependency>
                <groupId>cn.realm.cloud</groupId>
                <artifactId>realm-common</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Realm Spring Boot Excel 启动器依赖，提供 Excel 导入导出功能 -->
