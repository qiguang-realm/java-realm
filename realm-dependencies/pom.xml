<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== 基础配置 ========== -->
    <groupId>cn.realm.cloud</groupId>
    <artifactId>realm-dependencies</artifactId>
    <version>${revision}</version>
    <!-- BOM 类型项目管理依赖 -->
    <packaging>pom</packaging>

    <!-- ========== 项目信息 ========== -->
    <name>${project.artifactId}</name>
    <description>统一依赖管理 BOM (Bill of Materials)，集中管理项目所有第三方依赖版本</description>
    <!-- 建议替换为实际项目仓库地址 -->
    <url>https://github.com/</url>

    <!-- ========== 全局版本管理 ========== -->
    <properties>
        <!-- 基础版本控制 -->
        <revision>2.4.1-SNAPSHOT</revision>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>

        <!-- ===== Spring 生态 ===== -->
        <spring-boot.version>3.4.1</spring-boot.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
        <springdoc.version>2.7.0</springdoc.version>

        <!-- ===== 数据库相关 ===== -->
        <druid.version>1.2.24</druid.version>
        <mybatis.version>3.5.17</mybatis.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <dynamic-datasource.version>4.3.1</dynamic-datasource.version>
        <!-- 国产数据库驱动 -->
        <dm8.jdbc.version>8.1.3.140</dm8.jdbc.version>
        <kingbase.jdbc.version>8.6.0</kingbase.jdbc.version>
        <opengauss.jdbc.version>5.1.0</opengauss.jdbc.version>

        <!-- ===== 消息中间件 ===== -->
        <rocketmq-spring.version>2.3.1</rocketmq-spring.version>

        <!-- ===== 工具类库 ===== -->
        <lombok.version>1.18.36</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <hutool-5.version>5.8.35</hutool-5.version>
        <hutool-6.version>6.0.0-M19</hutool-6.version>
        <easyexcel.version>4.0.3</easyexcel.version>

        <!-- ===== 测试相关 ===== -->
        <podam.version>8.0.2.RELEASE</podam.version>
        <jedis-mock.version>1.1.4</jedis-mock.version>
        <mockito-inline.version>5.2.0</mockito-inline.version>

        <!-- ===== 其他重要组件 ===== -->
        <redisson.version>3.41.0</redisson.version>
        <xxl-job.version>2.4.0</xxl-job.version>
        <skywalking.version>9.0.0</skywalking.version>
        <netty.version>4.1.116.Final</netty.version>

        <!-- ===== 三方服务集成 ===== -->
        <aws-java-sdk-s3.version>1.12.777</aws-java-sdk-s3.version>
        <weixin-java.version>4.6.0</weixin-java.version>
        <!-- 其他版本配置... -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ========== 基础平台 BOM ========== -->
            <!-- Netty 平台依赖管理 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== Spring 生态 ========== -->
            <!-- Spring Boot 官方依赖管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud 微服务套件 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba 生态组件 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 核心业务组件 ========== -->
            <!-- 业务日志 SDK（排除 Spring Boot 基础依赖） -->
            <dependency>
                <groupId>io.github.mouzt</groupId>
                <artifactId>bizlog-sdk</artifactId>
                <version>${bizlog-sdk.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- 平台核心模块 -->
            <dependency>
                <groupId>cn.iocoder.cloud</groupId>
                <artifactId>yudao-spring-boot-starter-env</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ========== Web 服务组件 ========== -->
            <dependency>
                <groupId>cn.iocoder.cloud</groupId>
                <artifactId>yudao-spring-boot-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- API 文档解决方案 -->
            <dependency>
                <groupId>com.github.xingfudeshi</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- 网关专用文档组件（待版本升级） -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-gateway-spring-boot-starter</artifactId>
                <version>4.5.0</version> <!-- TODO 待升级至 4.6.0 -->
            </dependency>

            <!-- ========== 数据持久层组件 ========== -->
            <!-- MyBatis Plus 增强套件 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 多数据源动态切换 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- 分布式锁实现 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
                <version>${lock4j.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.redisson</groupId>
                        <artifactId>redisson-spring-boot-starter</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- ========== 基础设施组件 ========== -->
            <!-- 监控告警套件 -->
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-starter-server</artifactId>
                <version>${spring-boot-admin.version}</version>
            </dependency>

            <!-- 链路追踪工具包 -->
            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-trace</artifactId>
                <version>${skywalking.version}</version>
            </dependency>

            <!-- ========== 测试支撑组件 ========== -->
            <!-- 测试专用启动器 -->
            <dependency>
                <groupId>cn.iocoder.cloud</groupId>
                <artifactId>yudao-spring-boot-starter-test</artifactId>
                <version>${revision}</version>
                <scope>test</scope>
            </dependency>

            <!-- 增强型 Mock 工具 -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-inline</artifactId>
                <version>${mockito-inline.version}</version>
            </dependency>

            <!-- ========== 工具类库 ========== -->
            <!-- MapStruct 对象映射 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- 注意：修正 easyexcel 版本属性拼写 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- ========== 云服务集成 ========== -->
            <!-- 微信生态集成 -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-pay</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>

            <!-- AWS 云服务 SDK -->
            <dependency>
                <groupId>com.amazonaws</groupId>
                <artifactId>aws-java-sdk-s3</artifactId>
                <version>${aws-java-sdk-s3.version}</version>
            </dependency>

            <!-- ========== 特殊组件处理 ========== -->
            <!-- 积木报表（排除冲突依赖） -->
            <dependency>
                <groupId>org.jeecgframework.jimureport</groupId>
                <artifactId>jimureport-spring-boot3-starter-fastjson2</artifactId>
                <version>${jimureport.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.alibaba</groupId>
                        <artifactId>druid</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- 其他依赖项... -->

        </dependencies>
    </dependencyManagement>

    <!-- ========== BOM 构建配置 ========== -->
    <build>
        <plugins>
            <!-- Flatten 插件（BOM 专用配置） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <!-- BOM 项目使用特定模式 -->
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <!-- 生成扁平化 POM -->
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- 清理时移除临时文件 -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ========== 依赖声明 ========== -->
    <!-- 注意：实际依赖应在此处通过 dependencyManagement 声明 -->
    <!-- 示例：
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    -->
</project>
