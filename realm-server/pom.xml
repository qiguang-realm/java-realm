    <!--  [ 章节 ]  构建配置 / Build Configuration                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <build>
        <!-- 设置构建的 JAR 包名 / Set the final JAR name -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Spring Boot Maven 打包插件 / Spring Boot Maven Plugin -->
            <!-- 用于将应用打包为可执行 JAR（包含所有依赖）                         -->
            <!-- Used to repackage the application as an executable JAR            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 版本继承自父 POM，但为了明确，此处显式声明（需与父 POM 保持一致） -->
                <!-- Version inherited from parent, but explicitly declared here for clarity -->
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 JAR 打入最终包 / Repackage with all dependencies -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

