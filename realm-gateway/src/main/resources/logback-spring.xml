<?xml version="1.0" encoding="UTF-8"?>
<!--
╔══════════════════════════════════════════════════════════════════════════╗
║  Logback 日志配置（logback-spring.xml）                                ║
║  Logback Logging Configuration (logback-spring.xml)                   ║
║  参考 Spring Boot 默认配置（defaults.xml, file-appender.xml）         ║
║  Based on Spring Boot default configuration                          ║
╚══════════════════════════════════════════════════════════════════════════╝
-->
<configuration>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  日志输出格式定义 / Log Pattern Definitions                               -->
    <!--  参考 org/springframework/boot/logging/logback/defaults.xml              -->
    <!--  Reference: org/springframework/boot/logging/logback/defaults.xml        -->
    <!--                                                                          -->
    <!--  格式化说明 / Format specifiers:                                         -->
    <!--  %d      日期 / Date                                                     -->
    <!--  %thread 线程名 / Thread name                                            -->
    <!--  %-5level 日志级别（左对齐5字符） / Log level (left-aligned, 5 chars)   -->
    <!--  %msg    日志消息 / Log message                                          -->
    <!--  %n      换行 / Newline                                                  -->
    <!--  %logger{50} 日志记录器名称（最多50字符） / Logger name (max 50 chars)  -->
    <!--  %L      行号 / Line number                                              -->
    <!--                                                                          -->
    <!--  CONSOLE_LOG_PATTERN 比 FILE_LOG_PATTERN 多了 highlight、cyan 等高亮     -->
    <!--  CONSOLE_LOG_PATTERN has additional highlighting (highlight, cyan)       -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{50}:%L) - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50}:%L - %msg%n"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  控制台 Appender（STDOUT）                                               -->
    <!--  Console Appender (STDOUT)                                               -->
    <!--  将日志输出到控制台，使用 CONSOLE_LOG_PATTERN 格式（含高亮）            -->
    <!--  Outputs logs to the console with CONSOLE_LOG_PATTERN (with highlight)  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  文件 Appender（FILE）                                                  -->
    <!--  File Appender (FILE)                                                    -->
    <!--  参考 Spring Boot 的 file-appender.xml 编写                             -->
    <!--  Based on Spring Boot's file-appender.xml                               -->
    <!--                                                                          -->
    <!--  滚动策略：基于【每天 + 大小】创建日志文件                              -->
    <!--  Rolling policy: based on date + size                                   -->
    <!--  - 每日滚动，按大小分片 / Daily rollover with size-based splitting      -->
    <!--  - 保留最近 30 天日志 / Retain last 30 days                            -->
    <!--  - 单文件最大 10MB / Max file size: 10MB                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <!-- 日志文件路径 / Log file path -->
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 滚动文件名模式 / Rolling file name pattern -->
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 日志保留天数 / Log retention days -->
            <maxHistory>30</maxHistory>
            <!-- 单文件大小上限 / Max file size per file -->
            <maxFileSize>10MB</maxFileSize>
        </rollingPolicy>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  异步 Appender（ASYNC）                                                 -->
    <!--  Async Appender (ASYNC)                                                  -->
    <!--  异步写入日志（基于 FILE Appender），提升性能                           -->
    <!--  Asynchronously writes logs (based on FILE Appender) for performance   -->
    <!--                                                                          -->
    <!--  - 队列大小 512（默认 256）/ Queue size: 512 (default: 256)            -->
    <!--  - discardingThreshold=0：不丢弃任何级别日志                             -->
    <!--    No discarding of any log level (discardingThreshold=0)               -->
    <!--    默认：队列 80% 满时丢弃 TRACE、DEBUG、INFO 级别日志                  -->
    <!--    Default: discards TRACE, DEBUG, INFO when queue is 80% full          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  SkyWalking Appender（可选）                                            -->
    <!--  SkyWalking Appender (optional)                                         -->
    <!--  通过 GRPC 将日志发送到 SkyWalking 日志中心                            -->
    <!--  Sends logs to SkyWalking log center via GRPC                          -->
    <!--  已注释，需取消注释并添加相应依赖方可启用                              -->
    <!--  Commented out; uncomment and add the corresponding dependency to enable -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--
    <appender name="SKYWALKING" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>[%tid] ${FILE_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  根日志记录器（Root Logger）                                            -->
    <!--  Root Logger                                                             -->
    <!--  - 日志级别：INFO / Log level: INFO                                    -->
    <!--  - 输出目标：控制台（STDOUT）+ 异步文件（ASYNC）                       -->
    <!--    Output targets: Console (STDOUT) + Async File (ASYNC)               -->
    <!--                                                                          -->
    <!--  本地环境下，如果不想【FILE】打印日志，可以注释掉 ASYNC 行              -->
    <!--  To disable file logging in local environment, comment out ASYNC line  -->
    <!--  如需接入 SkyWalking 日志中心，请取消注释 SKYWALKING 行                -->
    <!--  To enable SkyWalking logging, uncomment SKYWALKING line               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <!-- 异步文件日志（本地环境可注释） / Async file log (comment out in local) -->
        <appender-ref ref="ASYNC"/>
        <!-- SkyWalking 日志中心（按需启用） / SkyWalking log center (enable as needed) -->
        <!-- <appender-ref ref="SKYWALKING"/> -->
    </root>

</configuration>
