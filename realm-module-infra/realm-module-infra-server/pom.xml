<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM model version -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父模块 / Inherit from parent -->
    <parent>
        <artifactId>realm-module-infra</artifactId>
        <groupId>cn.realm.cloud</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>realm-module-infra-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        Infra 服务端实现，提供基础设施运维（定时任务、服务器信息）和研发工具（代码生成器、接口文档）。
        Infra server implementation providing infrastructure operations and development tools.
    </description>

    <!-- 依赖管理 / Dependencies -->
    <dependencies>
        <!-- ========== Realm 基础 Starter ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-env</artifactId>
        </dependency>

        <!-- ========== 内部 API 依赖 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-module-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ========== 业务组件 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- ========== Web 与安全 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ========== 数据库 & 持久化 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- 代码生成器（用于解析表结构） / Code generator (table schema parser) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
        </dependency>
        <!-- Velocity 模板引擎（用于代码生成） / Velocity template engine (for code generation) -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>
        <!-- 同上，用于生成器模板引擎 / Same as above, for generator template engine -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- ========== 微服务 & RPC ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-rpc</artifactId>
        </dependency>
        <!-- Nacos 服务注册与配置 / Nacos registry & config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ========== 定时任务 & 消息队列 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-job</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-mq</artifactId>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ========== 工具类 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- ========== 监控 ========== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-spring-boot-starter-monitor</artifactId>
        </dependency>

        <!-- Spring Boot Admin Server（可选，按需启用） / Optional: Spring Boot Admin Server -->
        <!--
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-server</artifactId>
        </dependency>
        -->

        <!-- ========== 云服务 / 文件客户端 ========== -->
        <!-- FTP 客户端 / FTP client -->
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
        </dependency>
        <!-- SFTP 客户端 / SFTP client -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
        </dependency>
        <!-- S3 客户端（兼容 AWS S3、阿里云 OSS、腾讯云 COS、MinIO 等） -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- 文件类型识别 / File type detection -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
    </dependencies>

    <!-- 构建配置 / Build configuration -->
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
