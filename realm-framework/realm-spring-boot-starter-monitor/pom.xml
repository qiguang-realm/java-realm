<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 基础项目定义 -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>realm-spring-boot-starter-monitor</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>服务监控模块，提供链路追踪、日志服务、指标收集等功能</description>
    <url>https://github.com/</url>

    <dependencies>
        <!-- ==================== 基础依赖 ==================== -->
        <dependency>
            <groupId>cn.realm.cloud</groupId>
            <artifactId>realm-framework-common</artifactId>
        </dependency>

        <!-- ==================== Spring 核心支持 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId> <!-- AOP 切面支持，用于监控拦截 -->
        </dependency>

        <!-- ==================== Web 相关 ==================== -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope> <!-- 仅 TraceFilter 使用 -->
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope> <!-- 仅 TraceFilter 使用 -->
        </dependency>

        <!-- ==================== 监控与链路追踪 ==================== -->
        <!-- OpenTracing 支持 -->
        <dependency>
            <groupId>io.opentracing</groupId>
            <artifactId>opentracing-util</artifactId> <!-- OpenTracing 工具库 -->
        </dependency>

        <!-- SkyWalking 支持 -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-trace</artifactId> <!-- 链路追踪工具包 -->
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-logback-1.x</artifactId> <!-- Logback 日志集成 -->
        </dependency>
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-opentracing</artifactId> <!-- OpenTracing 适配 -->
        </dependency>

        <!-- ==================== 指标收集与监控 ==================== -->
        <!-- Prometheus 支持 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId> <!-- Micrometer 集成 Prometheus -->
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Admin 支持 -->
        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId> <!-- Spring Boot Admin 客户端 -->
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
