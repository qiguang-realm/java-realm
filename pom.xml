<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  POM Model Version (Required)                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Project Coordinates                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <groupId>cn.realm.cloud</groupId>
    <artifactId>realm-cloud</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Project Information                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <name>Realm Cloud Parent</name>
    <description>
        Parent POM for the Realm project, centralizing dependency version management
        and build plugin configurations for all submodules.
    </description>
    <url>https://github.com/your-org/realm</url> <!-- Replace with the actual repository URL -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Module Definitions (sorted alphabetically)                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <modules>
        <module>realm-dependencies</module>     <!-- BOM for unified dependency management -->
        <module>realm-documentation</module>    <!-- Project documentation module -->
        <module>realm-framework</module>        <!-- Core framework module -->
        <module>realm-gateway</module>          <!-- API gateway module -->
        <module>realm-module-system</module>    <!-- System management module -->
        <module>realm-server</module>           <!-- Main service module -->
    </modules>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Properties (Single Source of Truth for versions)          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <properties>
        <!-- Project version -->
        <revision>2026.08-SNAPSHOT</revision>

        <!-- JDK version -->
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Core plugin versions -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <flatten-maven-plugin.version>1.7.2</flatten-maven-plugin.version>

        <!-- Core dependency versions -->
        <spring-boot.version>3.5.4</spring-boot.version>
        <lombok.version>1.18.38</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <mapstruct-lombok-binding.version>0.2.0</mapstruct-lombok-binding.version>
    </properties>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Dependency Management (versions only, no actual imports)   -->
    <!--  Submodules inherit these versions without specifying them.              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <dependencyManagement>
        <dependencies>
            <!-- Import the BOM module to centrally manage all third-party dependency versions -->
            <dependency>
                <groupId>cn.realm.cloud</groupId>
                <artifactId>realm-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Build Configuration                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <build>
        <!-- ◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈ -->
        <!--  Plugin Management (default configurations inherited by submodules)   -->
        <!-- ◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈ -->
        <pluginManagement>
            <plugins>
                <!-- Compiler plugin: configures annotation processors for Lombok and MapStruct -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <!-- Spring Boot configuration metadata generator -->
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                            <!-- Lombok annotation processor -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- Lombok-MapStruct binding to ensure they work together -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${mapstruct-lombok-binding.version}</version>
                            </path>
                            <!-- MapStruct code generator -->
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <!-- Preserve method parameter names for Spring Boot 3+ -->
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Test plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- ◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈ -->
        <!--  Global Plugins (applied to all modules)                             -->
        <!-- ◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈◈ -->
        <plugins>
            <!-- Flatten Maven Plugin: replaces ${revision} with the actual version during release -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!--  [ SECTION ]  Repository Configuration (ordered by priority)             -->
    <!--  Add third-party repositories only when necessary.                       -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <repositories>
        <!-- Huawei Cloud mirror -->
        <repository>
            <id>huaweicloud</id>
            <name>Huawei Cloud Maven Mirror</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
        </repository>
        <!-- Alibaba Cloud mirror -->
        <repository>
            <id>aliyun</id>
            <name>Alibaba Cloud Maven Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

</project>
