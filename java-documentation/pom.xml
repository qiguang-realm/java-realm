<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

<!--    按照标准的顺序排列：modelVersion -> parent -> groupId（如果有的话） -> artifactId -> version -> packaging -> name -> description -> url -> 其他配置。    -->

    <!-- ========== 基础配置 ========== -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父 POM 配置 -->
    <parent>
        <groupId>cn.realm.cloud</groupId>
        <artifactId>realm</artifactId>
        <!-- 版本号与父 POM 的 revision 变量保持同步 -->
        <version>${revision}</version>
    </parent>

    <!-- ========== 项目标识 ========== -->
    <!-- 文档模块唯一标识（继承父项目的 groupId） -->
    <artifactId>java-documentation</artifactId>
    <!-- 使用 POM 类型管理文档相关配置 -->
    <packaging>pom</packaging>

    <!-- ========== 项目信息 ========== -->
    <name>${project.artifactId}</name>
    <!-- 详细模块描述（建议说明具体文档类型） -->
    <description>Java Development 项目文档模块，包含 API 文档、技术规范及部署指南</description>
    <!-- 建议替换为实际文档站点地址 -->
    <url>https://github.com/</url>

    <!-- ========== 模块扩展配置 ========== -->
    <!-- 注：如需管理文档生成插件（如 asciidoctor/maven-javadoc-plugin）可在此处添加 -->


